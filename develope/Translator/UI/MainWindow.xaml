<Window x:Class="Translator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:Translator.UI.ViewModels"
        mc:Ignorable="d"
        Title="Translator"
        Height="200"
        Width="460"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- 불리언 → Visibility 변환기 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 버튼 스타일 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상태 표시줄 ───────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,7"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 상태 텍스트 + 엔진 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 실행 중 표시기 -->
                    <Ellipse Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#AAAAAA"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding StatusText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <TextBlock Text="엔진: "
                               Foreground="#666666"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedEngine}"
                               Foreground="#333333"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <TextBlock Text="영역: "
                               Foreground="#666666"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveRegionsCount}"
                               Foreground="#333333"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 번역 On/Off 토글 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="번역"
                               Foreground="#555555"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ToggleButton Width="46" Height="24"
                                  IsChecked="{Binding IsRunning, Mode=OneWay}"
                                  Command="{Binding StartTranslationCommand}"
                                  ToolTip="번역 시작 (영역을 먼저 선택하세요)"
                                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis},
                                               ConverterParameter=Inverse}"/>
                    <ToggleButton Width="46" Height="24"
                                  IsChecked="True"
                                  Command="{Binding StopTranslationCommand}"
                                  ToolTip="번역 중지"
                                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 버튼 영역 ─────────────────────────────────────────────── -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <!-- 번역 시작 -->
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartTranslationCommand}"
                    ToolTip="등록된 영역에 대해 번역을 시작합니다"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis},
                                 ConverterParameter=Inverse}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶ " VerticalAlignment="Center"/>
                    <TextBlock Text="번역 시작" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 번역 중지 -->
            <Button Style="{StaticResource DangerButton}"
                    Command="{Binding StopTranslationCommand}"
                    ToolTip="번역을 중지합니다"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="■ " VerticalAlignment="Center"/>
                    <TextBlock Text="번역 중지" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 빈 자리 채우기 (중지 버튼이 없을 때) -->
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding OpenRegionSelectorCommand}"
                    ToolTip="화면에서 번역할 영역을 선택합니다">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⊞ " VerticalAlignment="Center"/>
                    <TextBlock Text="영역 선택" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding ClearRegionsCommand}"
                    ToolTip="등록된 모든 영역을 제거합니다">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕ " VerticalAlignment="Center"/>
                    <TextBlock Text="영역 초기화" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="번역 엔진, OCR, 오버레이 설정을 변경합니다">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙ " VerticalAlignment="Center"/>
                    <TextBlock Text="설정" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- ── 영역 목록 (간단한 리스트) ──────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <!-- 영역 없을 때 안내 문구 -->
                <TextBlock Text="영역을 선택하면 여기에 표시됩니다."
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontStyle="Italic"
                           Visibility="{Binding ActiveRegionsCount,
                                        Converter={StaticResource BoolToVis},
                                        ConverterParameter=Inverse}"/>

                <!-- 영역 목록 -->
                <ListBox ItemsSource="{Binding ActiveRegions}"
                         BorderThickness="0"
                         Background="Transparent"
                         Visibility="{Binding ActiveRegionsCount, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="6,2">
                                <Run Text="X:"/><Run Text="{Binding X, Mode=OneWay}"/>
                                <Run Text=" Y:"/><Run Text="{Binding Y, Mode=OneWay}"/>
                                <Run Text=" W:"/><Run Text="{Binding Width, Mode=OneWay}"/>
                                <Run Text=" H:"/><Run Text="{Binding Height, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ── 시스템 트레이 아이콘 ────────────────────────────────────── -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="0"
                        ToolTipText="Translator — 실시간 게임 번역"
                        IconSource="/Resources/app.ico"
                        Visibility="Visible"
                        TrayLeftMouseDoubleClick="TrayIcon_TrayLeftMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="열기" Click="TrayMenuItem_Open"/>
                    <Separator/>
                    <MenuItem Header="번역 시작"
                              Command="{Binding StartTranslationCommand}"/>
                    <MenuItem Header="번역 중지"
                              Command="{Binding StopTranslationCommand}"/>
                    <Separator/>
                    <MenuItem Header="설정"
                              Command="{Binding OpenSettingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="종료" Click="TrayMenuItem_Exit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
