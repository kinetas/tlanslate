<Window x:Class="Translator.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Translator.UI"
        mc:Ignorable="d"
        Title="설정"
        Width="640"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style x:Key="InputRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="TextInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="26" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 탭 컨트롤 -->
        <TabControl Grid.Row="0">

            <!-- 탭 1: 번역 엔진 선택 -->
            <TabItem Header="번역 엔진" Style="{StaticResource TabItemStyle}">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="번역 엔진 설정" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- 엔진 선택 -->
                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="번역 엔진 :" Style="{StaticResource LabelStyle}" />
                            <ComboBox ItemsSource="{Binding AvailableProviders}"
                                      SelectedItem="{Binding SelectedProvider}"
                                      Style="{StaticResource ComboStyle}" />
                        </StackPanel>

                        <!-- 목표 언어 -->
                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="번역 목표 언어 :" Style="{StaticResource LabelStyle}" />
                            <ComboBox ItemsSource="{Binding AvailableTargetLanguages}"
                                      SelectedItem="{Binding SelectedTargetLanguage}"
                                      Style="{StaticResource ComboStyle}" />
                        </StackPanel>

                        <Separator Margin="0,4,0,12" />

                        <!-- OpenAI 설정 (조건부 표시) -->
                        <StackPanel Visibility="{Binding IsOpenAiSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="OpenAI 설정" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel Style="{StaticResource InputRowStyle}">
                                <TextBlock Text="모델 ID :" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding OpenAiModelId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource InputRowStyle}">
                                <TextBlock Text="Base URL :" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- DeepL 설정 -->
                        <StackPanel Visibility="{Binding IsDeepLSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="DeepL 설정" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel Style="{StaticResource InputRowStyle}">
                                <TextBlock Text="Base URL :" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding DeepLBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Ollama 설정 -->
                        <StackPanel Visibility="{Binding IsOllamaSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Ollama 설정" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel Style="{StaticResource InputRowStyle}">
                                <TextBlock Text="모델 ID :" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding OllamaModelId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource InputRowStyle}">
                                <TextBlock Text="Base URL :" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- LMStudio 설정 -->
                        <StackPanel Visibility="{Binding IsLmStudioSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="LMStudio 설정" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel Style="{StaticResource InputRowStyle}">
                                <TextBlock Text="모델 ID :" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding LmStudioModelId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource InputRowStyle}">
                                <TextBlock Text="Base URL :" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding LmStudioBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInputStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 2: API Key 입력 -->
            <TabItem Header="API Key" Style="{StaticResource TabItemStyle}">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="API Key 설정" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="API Key는 Windows DPAPI를 통해 암호화되어 저장됩니다."
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="0,0,0,12" />

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="API Key :" Style="{StaticResource LabelStyle}" />
                            <!-- PasswordBox는 코드비하인드에서 이벤트로 처리 (평문 바인딩 금지) -->
                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Width="280"
                                         Height="26"
                                         PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />
                        </StackPanel>

                        <TextBlock Text="{Binding ApiKeyStatusMessage}"
                                   Foreground="{Binding ApiKeyStatusColor}"
                                   FontSize="11"
                                   Margin="148,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 3: OCR 설정 -->
            <TabItem Header="OCR" Style="{StaticResource TabItemStyle}">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="OCR 설정" Style="{StaticResource SectionHeaderStyle}" />

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="OCR 엔진 :" Style="{StaticResource LabelStyle}" />
                            <ComboBox ItemsSource="{Binding AvailableOcrEngines}"
                                      SelectedItem="{Binding SelectedOcrEngine}"
                                      Style="{StaticResource ComboStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="인식 언어 :" Style="{StaticResource LabelStyle}" />
                            <ComboBox ItemsSource="{Binding AvailableOcrLanguages}"
                                      SelectedItem="{Binding SelectedOcrLanguage}"
                                      Style="{StaticResource ComboStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="최소 신뢰도 임계값 :" Style="{StaticResource LabelStyle}" />
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding OcrMinConfidenceThreshold}"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" />
                            <TextBlock Text="{Binding OcrMinConfidenceThreshold, StringFormat={}{0:F1}}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="캡처 주기 (ms) :" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding OcrCaptureIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 4: 폰트/크기 설정 -->
            <TabItem Header="표시 설정" Style="{StaticResource TabItemStyle}">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="오버레이 표시 설정" Style="{StaticResource SectionHeaderStyle}" />

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="폰트 크기 :" Style="{StaticResource LabelStyle}" />
                            <Slider Minimum="8" Maximum="36"
                                    Value="{Binding OverlayFontSize}"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />
                            <TextBlock Text="{Binding OverlayFontSize, StringFormat={}{0:F0}pt}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="투명도 :" Style="{StaticResource LabelStyle}" />
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding OverlayOpacity}"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" />
                            <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="배경 색상 (ARGB) :" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding OverlayBackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="텍스트 색상 (ARGB) :" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding OverlayTextColor, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}">
                            <TextBlock Text="자동 숨김 지연 (ms) :" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding OverlayAutoHideDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                            <TextBlock Text="(0이면 숨김 없음)"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 5: 캐시 설정 -->
            <TabItem Header="캐시" Style="{StaticResource TabItemStyle}">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="캐시 설정" Style="{StaticResource SectionHeaderStyle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="캐시 활성화 :" Style="{StaticResource LabelStyle}" />
                            <CheckBox IsChecked="{Binding IsCacheEnabled}"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}"
                                    IsEnabled="{Binding IsCacheEnabled}">
                            <TextBlock Text="최대 캐시 항목 수 :" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding MaxCacheItems, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource InputRowStyle}"
                                    IsEnabled="{Binding IsCacheEnabled}">
                            <TextBlock Text="캐시 만료 시간 (분) :" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding CacheExpirationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextInputStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- 하단 버튼 영역 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="저장"
                    Width="80"
                    Height="30"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Margin="0,0,8,0" />
            <Button Content="취소"
                    Width="80"
                    Height="30"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
