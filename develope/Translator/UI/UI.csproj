    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Translator.UI</RootNamespace>
    <AssemblyName>Translator.UI</AssemblyName>
    <Platforms>x64</Platforms>
