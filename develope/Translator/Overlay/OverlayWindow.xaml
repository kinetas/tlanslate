<Window x:Class="Translator.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TranslatorOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        d:DesignHeight="1080"
        d:DesignWidth="1920">

    <!--
        클릭스루는 코드비하인드에서 SetWindowLong(WS_EX_TRANSPARENT | WS_EX_LAYERED)로 처리.
        IsHitTestVisible=False는 WPF 내부 히트테스트만 차단하며,
        Win32 레벨 클릭스루는 OverlayWindow.xaml.cs의 SetClickThrough()로 보장한다.
    -->

    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            IsHitTestVisible="False" />
</Window>
